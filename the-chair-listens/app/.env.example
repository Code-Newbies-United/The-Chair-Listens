# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
# Set the same variables in Vercel -> Project Settings -> Environment Variables.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq (AI reflections + Whisper transcription)
GROQ_API_KEY=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin login
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional: password-protect a test deployment (see middleware.js).
# TESTER_LOGINS is a comma-separated list of "user:password" pairs.
# TEST_EXPIRES is an ISO date after which the site returns 410.
TESTER_LOGINS=
TEST_EXPIRES=
