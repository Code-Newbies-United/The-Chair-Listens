# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
# Set the same variables in Vercel -> Project Settings -> Environment Variables.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Must NEVER be written into source code.
SUPABASE_SERVICE_ROLE_KEY=

# Groq (AI reflections + Whisper transcription)
GROQ_API_KEY=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rate limits. LEAVE EMPTY IN PRODUCTION.
# On a STAGING deployment only, set a number (e.g. 50) to multiply every limit,
# so a load test from one machine is not blocked by the per-IP limits.
RATE_LIMIT_MULTIPLIER=

# Error monitoring (Sentry). All optional: leave blank to switch monitoring off.
# Use the same DSN in both. NEXT_PUBLIC_ is needed for browser errors.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed if you want readable stack traces (source maps) from `next build`.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional: password-protect a test deployment (see middleware.js).
# TESTER_LOGINS is a comma-separated list of "user:password" pairs.
# TEST_EXPIRES is an ISO date after which the site returns 410.
# LEAVE BOTH EMPTY IN PRODUCTION, or real visitors will be locked out.
TESTER_LOGINS=
TEST_EXPIRES=
