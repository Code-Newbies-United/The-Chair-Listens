# Copy this file to .env.local (never commit .env.local) and fill in the values.
# Each Supabase project (dev, test, production) has its own values.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this key in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Groq (AI reflection and voice transcription)
GROQ_API_KEY=
